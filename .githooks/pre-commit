#!/bin/sh
# mc-downloader 的 pre-commit 门
#
# 两件事：① 暂存里有 .md → 查断链与"指向仓库外"的链接；② 暂存里有 .rs → 跑 `cargo fmt --all --check`。
#
# 为什么要这道门（2026-10-25 立）：
#   CI 第 3 步就是 `cargo fmt --all --check`，而从 P0/P1 起我改代码的方式是
#   「脚本往 .rs 里插 → 编译 → 测试 → 提交」，中间从没跑过 fmt
#   ⇒ CI 连红 5 次，我一次都没发现（因为每次只确认 git log / status / push）。
#   ⇒ 靠"记得跑"不可靠，用门。
#
# 为什么不在这里跑 clippy / test：
#   `cargo fmt --check` 只读源码、不编译（秒级）；clippy 和 test 要编译（分钟级），
#   放进来会让每次提交都卡住。CI 里那两步照旧。
#
# 判据：暂存里**有** .rs（新增/修改/复制）才查，纯文档提交不触发。

set -e

STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.md$" || true)

# ① Markdown 链接：断链、或指向仓库外（= 路径泄露）。
#    只查暂存的 .md（< 0.5 s）；查全仓会慢到有人用 --no-verify，CI 里有补刀。
if [ -n "$STAGED_MD" ]; then
    if ! python scripts/check-md-links.py $STAGED_MD; then
        echo ""
        echo "[pre-commit] Markdown 链接有问题：断链或指向仓库外"
        echo "  修法：指向仓库外的必须改成本仓内的相对路径"
        exit 1
    fi
fi


# ② 本机路径：与 CI 的 `No machine-specific paths` 同一套模式，拦暂存区里的绝对路径。
#    为什么放进钩子：这条规则我自己违反过（把带本机用户名的路径写进了 proofs/），而 CI 是最后一道。
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM | tr "\n" " " || true)
if [ -n "$STAGED_ALL" ]; then
    HITS=$(git grep -nE '[A-Za-z]:[\\/]Users[\\/][^<]|/Users/[A-Za-z][A-Za-z0-9._-]*/|C:[\\/]hub|lmq-mcd-target|Academic/(research|tools)' -- $STAGED_ALL ':!.githooks/pre-commit' 2>/dev/null || true)
    if [ -n "$HITS" ]; then
        echo ""
        echo "[pre-commit] 发现本机路径（公开仓不许）："
        echo "$HITS"
        exit 1
    fi
fi

if [ -z "$STAGED_RS" ]; then
    exit 0
fi

if ! cargo fmt --all --check > /dev/null 2>&1; then
    echo ""
    echo "[pre-commit] ✗ cargo fmt 未通过（本次暂存改了 .rs）"
    echo ""
    # 只显示前 20 行差异，避免刷屏
    cargo fmt --all --check 2>&1 | head -20
    echo ""
    echo "  修法：cargo fmt --all"
    echo "  然后重新 git add"
    echo ""
    exit 1
fi

echo "[pre-commit] rustfmt OK"
